# Copy this file to .env and fill in real values. Never commit .env.

# Google Cloud Console > Credentials > OAuth 2.0 Client ID (type: Web application).
# Safe to expose to the browser — Vite bundles anything prefixed VITE_.
VITE_GOOGLE_CLIENT_ID=

# Groq API key is NOT set here. It must never reach the client bundle.
# It's read server-side only, by the /api/transcribe Vercel Function
# (api/transcribe.js), via an environment variable configured directly in
# the Vercel dashboard. See Phase 6 for where it's wired in, Phase 10 for
# the Render -> Vercel hosting switch.
