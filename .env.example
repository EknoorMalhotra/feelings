# Copy this file to .env and fill in real values. Never commit .env.

# Google Cloud Console > Credentials > OAuth 2.0 Client ID (type: Web application).
# Safe to expose to the browser — Vite bundles anything prefixed VITE_.
VITE_GOOGLE_CLIENT_ID=

# Groq API key is NOT set here. It must never reach the client bundle.
# It's read server-side only, by the /api/transcribe serverless function,
# via an environment variable configured directly in the hosting platform
# (Render dashboard). See Phase 6 for where it's wired in.
